# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_BOT_TOKEN=

# ID de l'application (Developer Portal > General Information > Application ID)
DISCORD_APPLICATION_ID=

# ID du serveur Discord (clic droit sur le serveur > Copier l'identifiant, mode dev active)
DISCORD_GUILD_ID=

# Salon ou envoyer le message de bienvenue (optionnel : sinon le salon systeme du serveur)
DISCORD_WELCOME_CHANNEL_ID=

# Adresse du site RSA
RSA_API_URL=https://rsa.baccuarnaud.dev

# Meme valeur que le secret RSA_CRON_SECRET cote site
RSA_BOT_SECRET=
