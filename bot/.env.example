# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_BOT_TOKEN=

# ID de l'application (Developer Portal > General Information > Application ID)
DISCORD_APPLICATION_ID=

# ID du serveur Discord (clic droit sur le serveur > Copier l'identifiant, mode dev active)
DISCORD_GUILD_ID=

# Salon ou envoyer le message de bienvenue (optionnel : sinon le salon systeme du serveur)
DISCORD_WELCOME_CHANNEL_ID=

# Salon ou sont publiees les frequences radio (le message precedent est supprime)
# A renseigner cote SITE (secret DISCORD_RADIO_CHANNEL_ID) : c'est le site qui publie
DISCORD_RADIO_CHANNEL_ID=

# Salon ou sont annonces les redemarrages / pannes du serveur Arma 3
# A renseigner cote SITE (secret DISCORD_REBOOT_CHANNEL_ID)
DISCORD_REBOOT_CHANNEL_ID=

# Adresse du site RSA
RSA_API_URL=https://rsa.baccuarnaud.dev

# Meme valeur que le secret RSA_CRON_SECRET cote site
RSA_BOT_SECRET=

# Mettre a false si tu ne peux pas activer SERVER MEMBERS INTENT (desactive la bienvenue)
DISCORD_ENABLE_WELCOME=true
